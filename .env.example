# Groq is not required for the initial API scaffold.
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# Application settings
APP_NAME=DevForge AI
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
DATABASE_URL=sqlite:///./devforge.db
GENERATED_PROJECTS_DIR=generated_projects
WORKFLOW_CHECKPOINT_DB_PATH=workflow_checkpoints.sqlite3
# Optional. Required for requests from non-loopback clients.
API_ACCESS_TOKEN=
